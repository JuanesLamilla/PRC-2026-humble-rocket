# Copy to .env and fill in. Never commit .env.
# Team name is ASSIGNED by the organizers (adjective-noun, e.g. jolly-lobster) and must
# be used verbatim in submission filenames.
PRC_TEAM_NAME=
# Reported 2026 layout (verify against the access email): shared read bucket
# `prc-2026-datasets`, per-team write bucket `prc-2026-<team-name>`.
PRC_DATA_BUCKET=prc-2026-datasets
PRC_SUBMISSION_BUCKET=
# MinIO endpoint is https://s3.opensky-network.org (NOT the s3-console URL in the
# service-account JSON). Keys never go in this file:
#   mc alias set prc https://s3.opensky-network.org <access-key> <secret-key>
